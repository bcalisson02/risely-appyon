{
  "expo": {
    "name": "Risely",
    "slug": "risely",
    "scheme": "risely",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/risely-app-icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F2F2F7",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.appyon.risely"
    },
    "android": {
      "package": "com.appyon.risely",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/risely-app-icon-sm.png",
      "output": "single",
      "name": "Risely",
      "themeColor": "#F2F2F7"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": false,
      "tsconfigPaths": false
    }
  }
}
